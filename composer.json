{
  "name": "ardosia/cobblestone",
  "description": "Fixed-target Minecraft Windows 10 Edition Beta / MCPE 0.15.10 server foundation.",
  "type": "project",
  "license": "MIT OR Apache-2.0",
  "require": {
    "php": ">=8.5"
  },
  "suggest": {
    "ext-cobblestone_core_php": "Required to run the native-backed Cobblestone kernel."
  },
  "autoload": {
    "psr-4": {
      "Cobblestone\\Modules\\": "modules/",
      "Cobblestone\\": "src/Cobblestone/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cobblestone\\Tests\\": "tests/php/fixtures/"
    }
  },
  "scripts": {
    "build": "@php tools/project.php build",
    "check": "@php tools/project.php check",
    "modules": "@php tools/project.php modules",
    "native:build": "@php tools/project.php native:build",
    "native:check": "@php tools/project.php native:check",
    "serve": "@php tools/project.php serve",
    "test": "@php tools/project.php test",
    "test:php": "@php tools/project.php test:php",
    "verify": "@php tools/project.php verify"
  },
  "config": {
    "optimize-autoloader": true,
    "process-timeout": 0,
    "sort-packages": true
  }
}
