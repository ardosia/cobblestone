{
  "name": "ardosia/cobblestone",
  "description": "Fixed-target Minecraft Windows 10 Edition Beta / MCPE 0.15.10 server.",
  "type": "project",
  "license": "MIT OR Apache-2.0",
  "require": {
    "php": ">=8.5",
    "monolog/monolog": "^3.0",
    "psr/log": "^3.0"
  },
  "suggest": {
    "ext-cobblestone_core_php": "Required to run the native-backed Cobblestone server."
  },
  "autoload": {
    "psr-4": {
      "Cobblestone\\": "src/"
    },
    "files": [
      "src/Command/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Cobblestone\\Tests\\": "tests/php/fixtures/"
    }
  },
  "scripts": {
    "setup": "cargo +1.98.0 xtask setup",
    "build": "cargo +1.98.0 xtask build",
    "bench:scheduler": "@php benchmarks/php/scheduler.php",
    "bench:storage": "cargo run --quiet --release -p cobblestone-storage --example storage_bench",
    "check": "cargo +1.98.0 xtask check",
    "modules": "cargo +1.98.0 xtask modules",
    "native:build": "cargo +1.98.0 xtask native-build",
    "native:check": "cargo +1.98.0 xtask native-check",
    "serve": "cargo +1.98.0 xtask serve",
    "test": "cargo +1.98.0 xtask test",
    "test:php": "cargo +1.98.0 xtask test-php",
    "analyse": "phpstan analyse --no-progress",
    "format:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "test:phpunit": "phpunit --configuration phpunit.xml.dist",
    "verify": "cargo +1.98.0 xtask verify"
  },
  "config": {
    "optimize-autoloader": true,
    "process-timeout": 0,
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.4"
  }
}
