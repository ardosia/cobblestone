#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cobblestone\Log\LoggerFactory;
use Cobblestone\Server\Server;
use Cobblestone\Server\ServerConfig;
use Cobblestone\Server\WorldFactory;
use Cobblestone\World\Generator\WorldSeed;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Composer autoloader is missing; run composer build.\n");
    exit(1);
}

require_once $autoload;

if (!extension_loaded('cobblestone_core_php')) {
    fwrite(STDERR, "cobblestone_core_php extension is not loaded; run through composer serve.\n");
    exit(1);
}

try {
    $logs = LoggerFactory::console(getenv('COBBLESTONE_LOG_LEVEL') ?: 'INFO');
} catch (Throwable $error) {
    fwrite(STDERR, 'Failed to configure logging: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}

$logger = $logs->logger('Cobblestone.Application');
$bind = getenv('COBBLESTONE_BIND') ?: '0.0.0.0:19132';
$serverName = getenv('COBBLESTONE_SERVER_NAME') ?: 'Cobblestone';
$viewDistance = getenv('COBBLESTONE_VIEW_DISTANCE');
$viewDistance = is_string($viewDistance) && $viewDistance !== '' ? $viewDistance : '3';
$maxConnections = (int) (getenv('COBBLESTONE_MAX_CONNECTIONS') ?: '20');
$tickRate = (int) (getenv('COBBLESTONE_TICK_RATE') ?: '20');
$worldDir = getenv('COBBLESTONE_WORLD_DIR');
$worldDir = is_string($worldDir) && $worldDir !== ''
    ? $worldDir
    : dirname(__DIR__) . '/worlds/world';
$worldName = getenv('COBBLESTONE_WORLD_NAME') ?: 'Cobblestone';
$worldSeedInput = getenv('COBBLESTONE_WORLD_SEED');
$worldSeedInput = is_string($worldSeedInput) ? $worldSeedInput : '';
$saveWorkers = (int) (getenv('COBBLESTONE_SAVE_WORKERS') ?: '2');
$loadWorkers = (int) (getenv('COBBLESTONE_LOAD_WORKERS') ?: '2');
$compactionMinDeadBytesText = getenv('COBBLESTONE_COMPACTION_MIN_DEAD_BYTES');
$compactionMinDeadBytesText = is_string($compactionMinDeadBytesText) && $compactionMinDeadBytesText !== ''
    ? $compactionMinDeadBytesText
    : (string) WorldFactory::DEFAULT_COMPACTION_MIN_DEAD_BYTES;
$compactionMinDeadPercentText = getenv('COBBLESTONE_COMPACTION_MIN_DEAD_PERCENT');
$compactionMinDeadPercentText = is_string($compactionMinDeadPercentText) && $compactionMinDeadPercentText !== ''
    ? $compactionMinDeadPercentText
    : (string) WorldFactory::DEFAULT_COMPACTION_MIN_DEAD_PERCENT;

if ($maxConnections <= 0) {
    $logger->error('COBBLESTONE_MAX_CONNECTIONS must be positive');
    exit(1);
}
if (!preg_match('/^[1-3]$/', $viewDistance)) {
    $logger->error('COBBLESTONE_VIEW_DISTANCE must be a chunk radius between 1 and 3');
    exit(1);
}
if ($tickRate <= 0 || $tickRate > 1_000) {
    $logger->error('COBBLESTONE_TICK_RATE must be between 1 and 1000');
    exit(1);
}
if ($saveWorkers <= 0 || $saveWorkers > 32) {
    $logger->error('COBBLESTONE_SAVE_WORKERS must be between 1 and 32');
    exit(1);
}
if ($loadWorkers <= 0 || $loadWorkers > 32) {
    $logger->error('COBBLESTONE_LOAD_WORKERS must be between 1 and 32');
    exit(1);
}
if (!preg_match('/^\d+$/', $compactionMinDeadBytesText)) {
    $logger->error('COBBLESTONE_COMPACTION_MIN_DEAD_BYTES must be a nonnegative integer');
    exit(1);
}
$compactionMinDeadBytes = filter_var(
    $compactionMinDeadBytesText,
    FILTER_VALIDATE_INT,
    ['options' => ['min_range' => 0, 'max_range' => PHP_INT_MAX]],
);
if ($compactionMinDeadBytes === false) {
    $logger->error('COBBLESTONE_COMPACTION_MIN_DEAD_BYTES exceeds the supported integer range');
    exit(1);
}
if (!preg_match('/^\d+$/', $compactionMinDeadPercentText)) {
    $logger->error('COBBLESTONE_COMPACTION_MIN_DEAD_PERCENT must be an integer between 0 and 100');
    exit(1);
}
$compactionMinDeadPercent = (int) $compactionMinDeadPercentText;
if ($compactionMinDeadPercent < 0 || $compactionMinDeadPercent > 100) {
    $logger->error('COBBLESTONE_COMPACTION_MIN_DEAD_PERCENT must be between 0 and 100');
    exit(1);
}

try {
    $worldSeed = WorldSeed::fromTargetInput($worldSeedInput, WorldSeed::random());
    $world = WorldFactory::persistentInfinite(
        $worldDir,
        $worldName,
        $worldSeed,
        saveWorkers: $saveWorkers,
        loadWorkers: $loadWorkers,
        compactionMinDeadBytes: $compactionMinDeadBytes,
        compactionMinDeadPercent: $compactionMinDeadPercent,
    );
    $server = Server::create(
        new ServerConfig(
            bind: $bind,
            maxConnections: $maxConnections,
            name: $serverName,
            initialChunkRadius: (int) $viewDistance,
        ),
        world: $world,
        logs: $logs,
    );
} catch (Throwable $error) {
    $logger->critical('Failed to configure Cobblestone', ['exception' => $error]);
    exit(1);
}

$logger->info(
    'Configured Cobblestone',
    [
        'bind' => $bind,
        'protocol' => 84,
        'raknet' => 8,
        'tick_rate' => $tickRate,
        'world' => $server->world()->name(),
        'world_seed' => $server->world()->seed(),
        'world_generator' => $server->world()->generator()->name(),
        'world_dir' => $worldDir,
        'view_distance_chunks' => (int) $viewDistance,
        'compaction_min_dead_bytes' => $compactionMinDeadBytes,
        'compaction_min_dead_percent' => $compactionMinDeadPercent,
    ],
);

try {
    $server->run(tickRate: $tickRate);
} catch (Throwable) {
    exit(1);
}