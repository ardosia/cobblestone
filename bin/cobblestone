#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cobblestone\Log\LoggerFactory;
use Cobblestone\Server\Server;
use Cobblestone\Server\ServerRunner;
use Cobblestone\Tick\TickLoop;
use Cobblestone\Tick\TickLoopConfig;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Composer autoloader is missing; run composer build.\n");
    exit(1);
}

require_once $autoload;

if (!extension_loaded('cobblestone_core_php')) {
    fwrite(STDERR, "cobblestone_core_php extension is not loaded; run through composer serve.\n");
    exit(1);
}

try {
    $logs = LoggerFactory::console(getenv('COBBLESTONE_LOG_LEVEL') ?: 'INFO');
} catch (Throwable $error) {
    fwrite(STDERR, 'Failed to configure logging: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}

$logger = $logs->logger('Cobblestone.Application');
$bind = getenv('COBBLESTONE_BIND') ?: '0.0.0.0:19132';
$serverName = getenv('COBBLESTONE_SERVER_NAME') ?: 'Cobblestone';
$maxConnections = (int) (getenv('COBBLESTONE_MAX_CONNECTIONS') ?: '20');
$tickRate = (int) (getenv('COBBLESTONE_TICK_RATE') ?: '20');

if ($maxConnections <= 0) {
    $logger->error('COBBLESTONE_MAX_CONNECTIONS must be positive');
    exit(1);
}
if ($tickRate <= 0 || $tickRate > 1_000) {
    $logger->error('COBBLESTONE_TICK_RATE must be between 1 and 1000');
    exit(1);
}

$server = Server::start(
    $bind,
    $maxConnections,
    $serverName,
    logs: $logs,
);
$ticks = new TickLoop(
    new TickLoopConfig(tickRate: $tickRate),
    $logs->logger('Cobblestone.Tick'),
);
$runner = new ServerRunner(
    $server,
    $ticks,
    $logs->logger('Cobblestone.ServerRunner'),
);

$logger->info(
    'Started Cobblestone',
    [
        'bind' => $bind,
        'name' => $serverName,
        'protocol' => 84,
        'raknet' => 8,
        'tick_rate' => $tickRate,
    ],
);

try {
    $runner->run();
} catch (Throwable) {
    exit(1);
}
